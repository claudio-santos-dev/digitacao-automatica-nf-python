        .move_to_element(el)\
        .pause(0.2)\
        .click()\
        .perform()


# =========================
# VALIDAR LOOKUP
# =========================
def validar_lookup(label, texto_esperado):

    campo = wait.until(
        EC.presence_of_element_located((
            By.XPATH,
            f"//label[contains(text(),'{label}')]/ancestor::div[contains(@class,'x-form-item')]//input"
        ))
    )

    time.sleep(1)

    valor_tela = (
        campo.get_attribute("value")
        .strip()
        .upper()
    )

    texto_esperado = str(texto_esperado).strip().upper()

    print(f"🔎 Validando {label}: [{valor_tela}]")

    if texto_esperado not in valor_tela:

        raise Exception(
            f"{label} NÃO foi preenchido corretamente. "
            f"Esperado conter: {texto_esperado} | Tela: {valor_tela}"
        )

    print(f"✔ {label} validado")


# =========================
# LOOKUP
# =========================
def preencher_lookup_por_label(label, valor, nome_validacao):

    print(f"🔎 {label}...")

    for tentativa in range(3):

        try:

            # localiza o campo novamente
            campo = wait.until(
                EC.presence_of_element_located((
                    By.XPATH,
                    f"//label[contains(text(),'{label}')]/ancestor::div[contains(@class,'x-form-item')]//input"
                ))
            )

            # localiza a lupa novamente
            lupa = campo.find_element(
                By.XPATH,
                ".//following::img[contains(@class,'x-form-search-trigger')][1]"
            )

            clicar(lupa)

            campo_busca = wait.until(
                EC.element_to_be_clickable((
                    By.CSS_SELECTOR,
                    "#SearchTriggerWindowRemote_searchTextField"
                ))
            )

            campo_busca.click()
            campo_busca.clear()

            campo_busca.send_keys(str(valor))

            time.sleep(1)

            # garante foco
            driver.execute_script(
                "arguments[0].focus();",
                campo_busca
            )

            time.sleep(1)

            campo_busca.send_keys(Keys.ENTER)

            print("✔ Enter enviado")

            # espera a grade atualizar
            time.sleep(3)

            # pega SEMPRE o primeiro resultado
            primeiro_item = wait.until(
                EC.element_to_be_clickable((
                    By.XPATH,
                    "(//div[contains(@class,'x-grid3-cell-inner')])[1]"
                ))
            )

            driver.execute_script(
                "arguments[0].scrollIntoView({block:'center'});",
                primeiro_item
            )

            time.sleep(1)

            clicar(primeiro_item)

            btn_select = wait.until(
                EC.element_to_be_clickable((
                    By.CSS_SELECTOR,
                    "#SearchTriggerWindowRemote_selectButton"
                ))
            )

            clicar(btn_select)

            time.sleep(2)

            validar_lookup(
                label,
                nome_validacao
            )

            print(f"✔ {label} OK")

            return

        except Exception as e:

            print(f"⚠ Retry {label}: {e}")

            try:
                driver.find_element(
                    By.TAG_NAME,
                    "body"
                ).send_keys(Keys.ESCAPE)
            except:
                pass

            time.sleep(2)

    raise Exception(
        f"Falha ao selecionar {label}"
    )

